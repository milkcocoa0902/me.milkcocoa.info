{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "me-milkcocoa-info",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "cache": {
    "enabled": false
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "minify": true,
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "business-contact",
      "migrations_dir": "migrations/contact"
    }
  ],
  "vars": {
    "CONTACT_AWS_ROLE_ARN": "",
    "CONTACT_LAMBDA_ALIAS_ARN": ""
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY",
      "CONTACT_EMAIL_ENCRYPTION_KEY",
      "CONTACT_AWS_ACCESS_KEY_ID",
      "CONTACT_AWS_SECRET_ACCESS_KEY"
    ]
  }
}
